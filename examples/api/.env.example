# Example API — environment variables.
# Every variable the app reads is listed below with its default. This file turns the full feature
# set on for local development (needs Docker); copy it to `.env` and adjust. A bare run with no
# `.env` still needs Postgres for the catalog (`docker compose up -d postgres`); everything else —
# MongoDB, RabbitMQ — stays opt-in.

# ── Application ──────────────────────────────────────────────────────────────
# HTTP port. Default: 3000
PORT=3000
# development | production. Default: development
NODE_ENV=development
# Pino log level, used unless FEATURE_PINO_LOGGER=false. Default: debug (dev) / info (production)
# LOG_LEVEL=debug

# ── Feature flags ────────────────────────────────────────────────────────────
# Catalog persistence adapter. Mutually exclusive — both map the same Postgres `products` table, so
# either way the catalog needs a database. Default: mikro-orm
# Values: mikro-orm | typeorm
SQL_ORM=typeorm
# HTTP client backing the outgoing ports (content ArticleGateway, reviews ReviewerGateway) — selects
# which HTTP Client instrumentation captures the calls (axios via @nestjs/axios, or native fetch).
# Default: axios
# Values: axios | fetch
HTTP_CLIENT=axios
# Mongoose-backed reviews (needs MongoDB). Opt-in. Default: false
FEATURE_MONGOOSE=true
# GraphQL API over the catalog (served over either adapter). Default: true (on)
FEATURE_GRAPHQL=true
# RabbitMQ review.created producer/consumer + nest-profiler-rabbitmq (needs a broker). Default: false
FEATURE_RABBITMQ=true
# Batch the GraphQL reviews + author lookups with request-scoped DataLoaders: one
# find({ productId: { $in: … } }) and one GET /users?id=… instead of one query per product and one
# call per review. Off by default so the demo query keeps its visible N+1. Default: false
FEATURE_DATALOADER=false
# Use the third-party nestjs-pino logger (JSON logs). Set it to false for the Nest ConsoleLogger.
# Default: true
FEATURE_PINO_LOGGER=true
# OpenRouter-backed assistant with streamed answers (POST /ai/ask, POST /ai/stream, GET /ai/sse),
# and the app's own MCP endpoint at /mcp. Needs OPENROUTER_API_KEY; excluded from the Vercel
# deployment. Default: false
FEATURE_AI=false

# ── Profiler ─────────────────────────────────────────────────────────────────
# Enable the profiler UI + collectors; false loads the zero-cost no-op fallback. Default: true
PROFILER_ENABLED=true

# Automatic instrumentation: one span per provider method call, so the Performance tab shows the
# full call tree (controller → service → repository) instead of only the I/O. On here because this
# app is a demo and the tree is the thing to see; set it to false to view a trace as an application
# that has not opted in sees it. In your own app it is opt-in and development-only — it proxies
# every provider, which costs on every call, profiled or not.
PROFILER_INSTRUMENT=true
# Classes and methods to keep off the instrumented trace, comma-separated. A class name takes the
# whole provider off it (ConfigService), a Class.method label one method (AppService.tick), and
# `*` is a wildcard within a name (*.getRequestId). Empty here — this app has no such noise; a
# real one usually does.
PROFILER_INSTRUMENT_EXCLUDE=
# Storage backend: memory | file | sqlite. `file` and `sqlite` are cross-process, so CLI command
# profiles show up in the HTTP app's web profiler at /_profiler; `sqlite` filters and paginates in
# the database (requires `pnpm add @libsql/client`). Default: file
PROFILER_STORAGE_TYPE=file
# `file`: profiles directory. `sqlite`: local database file (default .profiler/profiler.db). Ignored
# when PROFILER_STORAGE_URL is set. Default: .profiler
PROFILER_STORAGE_PATH=.profiler
# Seconds before a stored profile expires (file/sqlite storage). Default: 3600
PROFILER_TTL=3600
# Maximum profiles kept (LRU eviction). Default: 200
PROFILER_MAX_PROFILES=200
# IANA timezone the dashboard renders timestamps in (Europe/Paris, UTC, America/New_York…).
# Unset: the timezone the process runs in. Set it when the app runs in a UTC container.
# PROFILER_TIMEZONE=Europe/Paris
# Editor every source location in the Exceptions tab links to (vscode, vscode-insiders, cursor,
# windsurf, zed, webstorm, idea, phpstorm, sublime, textmate), or a URL template with %f and %l.
# Unset: locations render as plain text. Only useful when the app runs on your own machine.
# PROFILER_EDITOR=vscode
# Remote SQLite database for PROFILER_STORAGE_TYPE=sqlite. When set, the SQLite adapter targets this
# remote database instead of the local file — same adapter. Leave empty for a local database. On
# Vercel these fall back to the Turso integration's TURSO_DATABASE_URL / TURSO_AUTH_TOKEN.
# PROFILER_STORAGE_URL=libsql://your-database.example.com
# PROFILER_STORAGE_AUTH_TOKEN=your-auth-token
# Access control guarding /_profiler in the demo (like SQL_ORM picks an adapter). Off by default.
#   basic → HTTP Basic auth with PROFILER_BASIC_USER / PROFILER_BASIC_PASSWORD (browser prompt / curl -u)
#   token → bearer or ?token=<PROFILER_TOKEN> (query threaded across UI links via linkQuery)
#   cookie→ reuse the app's JwtAuthGuard (security.guards). GET /api/v1/auth/token sets a JWT cookie
#           the browser sends on every link, so /_profiler is navigable (Bearer header also accepted)
# PROFILER_AUTH=basic
# Credentials for PROFILER_AUTH=basic (username defaults to `admin`).
# PROFILER_BASIC_USER=admin
# PROFILER_BASIC_PASSWORD=your-secret-password
# Secret for PROFILER_AUTH=token.
# PROFILER_TOKEN=your-secret-token

# ── AI (only used when FEATURE_AI=true) ──────────────────────────────────────
# OpenRouter key — https://openrouter.ai/keys. Required when FEATURE_AI=true.
OPENROUTER_API_KEY=
# Model id. The default is a free OpenRouter model, so the demo costs nothing; any `:free` model
# works (https://openrouter.ai/models?max_price=0). Free models are best-effort — some ignore the
# system message or never answer, so check a replacement streams before adopting it.
# Default: liquid/lfm-2.5-2.6b:free
# AI_MODEL=liquid/lfm-2.5-2.6b:free
# Answer length cap. Keep it roomy: a small free model that runs out mid-JSON makes
# `POST /ai/object` fail to parse. Default: 512
# AI_MAX_OUTPUT_TOKENS=512
# Sampling temperature. Default: 0.7
# AI_TEMPERATURE=0.7
# How hard the model thinks before answering, when it has a reasoning phase. The reasoning text and
# its token count land in the AI panel. Default: provider-default
# Values: provider-default | none | minimal | low | medium | high | xhigh
# AI_REASONING=provider-default
# Model Context Protocol server whose tools are merged into the assistant's own. Its tools appear
# in the AI panel like any other, flagged `mcp` because they are discovered at runtime. A server
# advertising very large tool descriptions can overflow a small model's context. Empty: off.
# The app serves its own MCP endpoint under this same flag, so it can point at itself.
# AI_MCP_URL=http://localhost:3000/mcp
# Cap on a whole generation, so a stalled free model cannot hang a request. Default: 30000
# AI_TIMEOUT_MS=30000
# Where the AI panel gets token prices from, to cost the calls whose provider reports no cost.
# `openrouter` reads OpenRouter's public model list once at startup and caches it for a day.
# Values: openrouter | (empty, off)
# AI_PRICING=openrouter
# How much of what was said the AI panel stores: prompts, completions, reasoning, tool payloads.
# `redacted` is the collector's own default — credentials and personal data masked. This demo
# overrides it to `full` so the panel shows the prompts verbatim; nothing here is real data.
# Values: none | metadata | redacted | full
# A bare level here also opts into the runtime context (the tenant the assistant threads through
# each generation), which the collector never records on its own.
# AI_CAPTURE=full
# One level per field or group instead, comma-separated — fields: instructions, messages,
# completion, reasoning, toolDefinitions, toolArguments, toolResults, output, runtimeContext;
# groups: prompt (instructions + messages), tools (the three tool fields); default covers the rest.
# AI_CAPTURE=default:redacted,prompt:metadata,toolResults:none,runtimeContext:redacted
# App attribution sent to OpenRouter (HTTP-Referer / X-OpenRouter-Title headers).
# AI_APP_URL=https://nest-profiler.eleven-labs.com
# AI_APP_TITLE=nest-profiler example API

# ── Database (PostgreSQL — only used when SQL_ORM=typeorm|mikro-orm) ──────────
# Start with: pnpm docker:up (from the project root)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=profiler
DATABASE_PASSWORD=profiler
DATABASE_NAME=profiler_example
# Enable SSL for hosted Postgres providers such as Neon. PGSSLMODE=require is also supported. On
# Vercel the app also falls back to the Neon integration's POSTGRES_* / PG* variables.
DATABASE_SSL=false
# Schema management (the demo has no migrations). Both default to NODE_ENV !== 'production':
# outside production the ORM creates the table and drops-and-recreates it on boot (clean slate when
# switching SQL_ORM); on a hosted deploy set DATABASE_SYNCHRONIZE=true to create the schema without
# the destructive drop. Override explicitly if needed.
# DATABASE_SYNCHRONIZE=true
# DATABASE_DROP_SCHEMA=false

# ── MongoDB (only used when FEATURE_MONGOOSE=true — run: docker compose up -d mongodb) ──
MONGODB_URI=mongodb://localhost:27017/profiler_example

# ── RabbitMQ (only used when FEATURE_RABBITMQ=true — run: docker compose up -d rabbitmq) ──
RABBITMQ_URI=amqp://profiler:profiler@localhost:5672
