<%
  const ev = profile.entrypoint.data;
  const evDur = profile.performance.duration;
  const evError = profile.exceptions.length > 0 ? profile.exceptions[0].message : null;
  const hasPayload = ev.payload !== undefined && ev.payload !== null;
%>

<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8">
  <div class="bg-surface-muted border border-line rounded-lg p-4">
    <p class="text-foreground-faint text-2xs uppercase tracking-widest mb-2">Status</p>
    <p class="text-xl font-bold <%= ev.success ? 'text-success' : 'text-danger' %>"><%= ev.success ? 'OK' : 'Failed' %></p>
  </div>
  <div class="bg-surface-muted border border-line rounded-lg p-4">
    <p class="text-foreground-faint text-2xs uppercase tracking-widest mb-2">Duration</p>
    <p class="text-foreground text-xl font-bold tabular-nums"><%= evDur !== undefined ? evDur + 'ms' : '—' %></p>
  </div>
  <div class="bg-surface-muted border border-line rounded-lg p-4">
    <p class="text-foreground-faint text-2xs uppercase tracking-widest mb-2">Started</p>
    <p class="text-foreground text-sm font-bold tabular-nums"><%= timeOnly(profile.performance.startTime) %></p>
  </div>
</div>

<section class="mb-6">
  <h2 class="text-foreground-muted text-2xs uppercase tracking-widest font-semibold mb-3">Event</h2>
  <code class="block bg-surface-muted border border-line rounded-lg px-4 py-3 text-foreground text-sm break-all">
    <span class="px-1.5 py-0.5 rounded text-2xs font-bold tracking-wide badge-default mr-2">EVENT</span><%= ev.event %>
  </code>
</section>

<section class="mb-6">
  <h2 class="text-foreground-muted text-2xs uppercase tracking-widest font-semibold mb-3">Handler</h2>
  <code class="block bg-surface-muted border border-line rounded-lg px-4 py-3 text-sm break-all">
    <span class="text-foreground"><%= ev.provider %></span>.<%= ev.method %><span class="text-foreground-faint">()</span>
  </code>
</section>

<section <%= evError ? 'class="mb-6"' : '' %>>
  <h2 class="text-foreground-muted text-2xs uppercase tracking-widest font-semibold mb-3">Payload</h2>
  <% if (!hasPayload) { %>
    <p class="text-foreground-faint text-xs italic py-1">No payload captured.</p>
  <% } else { %>
    <pre class="bg-surface-muted border border-line rounded-lg p-4 overflow-x-auto text-xs leading-relaxed"><code class="language-json"><%= toJson(ev.payload) %></code></pre>
  <% } %>
</section>

<% if (evError) { %>
  <section>
    <h2 class="text-foreground-muted text-2xs uppercase tracking-widest font-semibold mb-3">Error</h2>
    <pre class="bg-danger-bg border border-danger-line rounded-lg px-4 py-3 text-danger text-xs whitespace-pre-wrap break-all"><%= evError %></pre>
  </section>
<% } %>
