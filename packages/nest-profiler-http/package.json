{
  "name": "@eleven-labs/nest-profiler-http",
  "version": "1.2.1",
  "description": "Client-agnostic HTTP-client collector for @eleven-labs/nest-profiler \u2014 pluggable axios/fetch instrumentations",
  "keywords": [
    "nestjs",
    "http-client",
    "axios",
    "fetch",
    "timings",
    "profiler",
    "debug",
    "monitoring",
    "devtools",
    "nest-profiler",
    "web-debug-toolbar",
    "observability"
  ],
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./axios": {
      "import": {
        "types": "./dist/esm/axios/index.d.ts",
        "default": "./dist/esm/axios/index.js"
      },
      "require": {
        "types": "./dist/axios/index.d.ts",
        "default": "./dist/axios/index.js"
      },
      "default": "./dist/axios/index.js"
    },
    "./fetch": {
      "import": {
        "types": "./dist/esm/fetch/index.d.ts",
        "default": "./dist/esm/fetch/index.js"
      },
      "require": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "default": "./dist/fetch/index.js"
    },
    "./phases": {
      "import": {
        "types": "./dist/esm/phases/index.d.ts",
        "default": "./dist/esm/phases/index.js"
      },
      "require": {
        "types": "./dist/phases/index.d.ts",
        "default": "./dist/phases/index.js"
      },
      "default": "./dist/phases/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "axios",
    "fetch",
    "phases",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "repo-build && tsx ./scripts/build-assets.ts",
    "clean": "repo-clean dist coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit --incremental false && tsc --noEmit -p src/client/tsconfig.json"
  },
  "peerDependencies": {
    "@eleven-labs/nest-profiler": "^1.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "axios": "^1.0.0",
    "nestjs-cls": "^6.0.0 || ^7.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eleven-labs/nest-profiler": "workspace:*",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "@repo/build": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "axios": "^1.20.0",
    "jest": "^30.5.2",
    "nestjs-cls": "^7.0.1",
    "reflect-metadata": "^0.2.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "@repo/jest-config",
    "rootDir": ".",
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/index.ts",
      "!src/client/**"
    ],
    "coverageDirectory": "coverage"
  },
  "author": {
    "name": "Fabien Pasquet",
    "url": "https://github.com/fpasquet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleven-labs/nest-profiler.git",
    "directory": "packages/nest-profiler-http"
  },
  "homepage": "https://nest-profiler.eleven-labs.com/docs/packages/nest-profiler-http",
  "bugs": {
    "url": "https://github.com/eleven-labs/nest-profiler/issues"
  },
  "contributors": [
    {
      "name": "Eleven Labs",
      "url": "https://eleven-labs.com"
    }
  ],
  "funding": "https://eleven-labs.com"
}
