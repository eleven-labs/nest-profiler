<%
  const requests = data || [];
  const totalDuration = requests.reduce((sum, r) => sum + r.duration, 0);
  const hasTag = (r, id) => (r.tags || []).some(t => t.id === id);
  const errCount = requests.filter(r => hasTag(r, 'error')).length;
  const slowCount = requests.filter(r => hasTag(r, 'slow')).length;
  const dupGroups = new Set(requests.filter(r => hasTag(r, 'n-plus-one') && r.fingerprint).map(r => r.fingerprint));
  const slowSev = sevOfTag(requests, 'slow');
  const nPlusOneSev = sevOfTag(requests, 'n-plus-one');

  // Phase vocabulary, in the order phases occur. Inline (like the timeline's kind maps) because a
  // template cannot import the package's TypeScript — the same names live in HTTP_PHASE_LABELS.
  const phaseMeta = [
    ['wait',      'Wait',           '#94a3b8', 'Client-side queueing before the transport started connecting — a saturated agent shows up here.'],
    ['dns',       'DNS',            '#a78bfa', 'Resolving the hostname. Absent on a reused connection or an IP literal.'],
    ['tcp',       'TCP',            '#60a5fa', 'TCP handshake. Absent on a reused connection.'],
    ['tls',       'TLS',            '#34d399', 'TLS handshake. Absent on plain HTTP and on a reused connection.'],
    ['connect',   'Connect',        '#38bdf8', 'DNS + TCP + TLS together, for a client that cannot break the handshake down (undici).'],
    ['request',   'Request',        '#fbbf24', 'Sending the request, until its last byte left the process.'],
    ['firstByte', 'Waiting (TTFB)', '#f472b6', 'Waiting for the first response byte — upstream think time plus return latency.'],
    ['download',  'Download',       '#22d3ee', 'Streaming the response body, first byte to last.'],
  ];
  const phaseMs = (v) => (v >= 10 ? Math.round(v) : Math.round(v * 100) / 100) + 'ms';

  // Only phases that actually cost something are drawn: a measured 0ms segment renders as
  // nothing and would only add noise to the legend.
  const phasesOf = (r) => {
    const segments = phaseMeta
      .map(([key, label, color, hint]) => [key, label, color, hint, r.phases ? r.phases[key] : undefined])
      .filter(([, , , , value]) => typeof value === 'number' && value > 0);
    if (segments.length === 0) return null;

    const measured = segments.reduce((sum, [, , , , value]) => sum + value, 0);
    // Normalised on whichever is larger: phases are timed on a monotonic clock while `duration`
    // is millisecond-granular, so a fast call can measure marginally more than it lasted.
    const total = Math.max(r.duration, measured);
    const rest = Math.max(0, total - measured);
    return { segments, measured, total, rest };
  };
%>

<div class="flex items-center justify-between mb-4">
  <div class="flex items-center gap-4 text-xs text-foreground-muted">
    <span><strong class="text-foreground"><%= requests.length %></strong> request<%= requests.length !== 1 ? 's' : '' %></span>
    <span><strong class="text-foreground"><%= totalDuration %></strong>ms total</span>
    <% if (errCount > 0) { %><span class="text-danger"><strong><%= errCount %></strong> err</span><% } %>
    <% if (slowCount > 0) { %><span class="<%= sevTextClass(slowSev) %>"><strong><%= slowCount %></strong> slow</span><% } %>
    <% if (dupGroups.size > 0) { %><span class="<%= sevTextClass(nPlusOneSev) %>"><strong><%= dupGroups.size %></strong> N+1</span><% } %>
  </div>
</div>

<% if (requests.length === 0) { %>
  <div class="py-8 text-center bg-surface-muted border border-line rounded-lg">
    <p class="text-foreground-muted text-sm">No outgoing HTTP requests during this request.</p>
  </div>
<% } else { %>
  <div class="rounded-lg border border-line overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="bg-surface-muted border-b border-line">
          <th class="text-left py-2.5 px-4 text-foreground-muted font-medium text-2xs uppercase tracking-widest w-20">Time</th>
          <th class="text-left py-2.5 px-4 text-foreground-muted font-medium text-2xs uppercase tracking-widest w-20">Duration</th>
          <th class="text-left py-2.5 px-4 text-foreground-muted font-medium text-2xs uppercase tracking-widest w-32">Phases</th>
          <th class="text-left py-2.5 px-4 text-foreground-muted font-medium text-2xs uppercase tracking-widest w-16">Method</th>
          <th class="text-left py-2.5 px-4 text-foreground-muted font-medium text-2xs uppercase tracking-widest">URL</th>
          <th class="text-left py-2.5 px-4 text-foreground-muted font-medium text-2xs uppercase tracking-widest w-16">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line-subtle">
        <% for (let i = 0; i < requests.length; i++) { %>
          <% const r = requests[i]; %>
          <%
            const hasRequest = (r.requestHeaders && Object.keys(r.requestHeaders).length > 0) || r.requestBody != null;
            const hasResponse = (r.responseHeaders && Object.keys(r.responseHeaders).length > 0) || r.responseBody != null;
            const phases = phasesOf(r);
            const hasDetails = hasRequest || hasResponse || phases !== null;
            const detailsRowId = `http-row-details-${i}`;
            const slowTag = (r.tags || []).find(t => t.id === 'slow');
          %>
          <tr
            class="<%= hasDetails ? 'cursor-pointer hover:bg-surface-muted' : 'hover:bg-surface-muted' %> transition-colors align-top"
            <% if (hasDetails) { %>
              data-toggle-details
              data-details-id="<%= detailsRowId %>"
              aria-expanded="false"
              role="button"
              tabindex="0"
            <% } %>
          >
            <td class="py-2 px-4 text-foreground-secondary text-xs tabular-nums whitespace-nowrap"><%= timeOnly(r.startedAt) %></td>
            <td class="py-2 px-4 text-left text-xs tabular-nums <%= slowTag ? sevTextClass(slowTag.severity) + ' font-bold' : 'text-foreground-secondary' %>"><%= r.duration %>ms</td>
            <td class="py-2 px-4">
              <% if (phases) { %>
                <div class="flex h-2 w-full min-w-24 overflow-hidden rounded-sm bg-surface-muted"
                     title="<%= phases.segments.map(([, label, , , value]) => label + ' ' + phaseMs(value)).join(' · ') %><%= phases.rest > 0 ? ' · Other ' + phaseMs(phases.rest) : '' %>">
                  <% for (const [key, label, color, hint, value] of phases.segments) { %>
                    <span style="width:<%= (value / phases.total) * 100 %>%;background:<%= color %>;"
                          title="<%= label %> — <%= phaseMs(value) %>. <%= hint %>"></span>
                  <% } %>
                  <% if (phases.rest > 0) { %>
                    <span style="width:<%= (phases.rest / phases.total) * 100 %>%;"
                          class="bg-line"
                          title="Other — <%= phaseMs(phases.rest) %> the phases do not account for: client-side work (interceptors, serialisation) and anything the client did not report."></span>
                  <% } %>
                </div>
              <% } else { %>
                <span class="text-foreground-faint text-2xs">—</span>
              <% } %>
            </td>
            <td class="py-2 px-4 whitespace-nowrap">
              <div class="inline-flex items-center gap-2">
                <% if (hasDetails) { %>
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded border border-line-subtle text-foreground-faint">
                    <span data-http-indicator="true" class="text-2xs leading-none">▸</span>
                  </span>
                <% } else { %>
                  <span class="inline-flex h-5 w-5 items-center justify-center text-foreground-faint text-2xs">•</span>
                <% } %>
                <span class="px-1.5 py-0.5 rounded text-2xs font-bold tracking-wide badge-<%= r.method.toLowerCase() %> badge-default"><%= r.method %></span>
              </div>
            </td>
            <td class="py-2 px-4 text-foreground-secondary text-xs break-all">
              <div class="flex items-start justify-between gap-2">
                <span class="min-w-0">
                  <%= r.url %>
                  <% if (r.error) { %><span class="block text-danger text-2xs mt-0.5"><%= r.error %></span><% } %>
                  <% if (r.tags && r.tags.length > 0) { %>
                    <span class="mt-1 flex flex-wrap gap-1"><%- tagBadges(r.tags) %></span>
                  <% } %>
                </span>
                <span class="shrink-0"><%- copyBtn(buildCurl({ method: r.method, url: r.url, headers: r.requestHeaders, body: r.requestBody }), 'Copy as cURL') %></span>
              </div>
            </td>
            <td class="py-2 px-4 whitespace-nowrap">
              <% if (r.statusCode) { %>
                <span class="px-1.5 py-0.5 rounded text-2xs font-bold <%= statusClass(r.statusCode) %>"><%= r.statusCode %></span>
              <% } else { %>
                <span class="text-foreground-faint text-xs">—</span>
              <% } %>
            </td>
          </tr>

          <% if (hasDetails) { %>
            <tr id="<%= detailsRowId %>" class="hidden bg-surface-subtle" data-http-details="true">
              <td colspan="6" class="px-4 py-3">
                <div class="space-y-3">
                  <% if (phases) { %>
                    <section class="bg-surface border border-line-subtle rounded p-2.5">
                      <p class="text-2xs text-foreground-faint uppercase tracking-widest font-semibold mb-1.5">Timing</p>
                      <div class="space-y-1">
                        <% for (const [key, label, color, hint, value] of phases.segments) { %>
                          <div class="flex items-center gap-2 text-2xs">
                            <span class="inline-block h-2 w-2 shrink-0 rounded-sm" style="background:<%= color %>;"></span>
                            <span class="w-28 shrink-0 text-foreground-secondary cursor-help" title="<%= hint %>"><%= label %></span>
                            <span class="w-16 shrink-0 text-right tabular-nums text-foreground"><%= phaseMs(value) %></span>
                            <span class="min-w-0 grow">
                              <span class="block h-1.5 rounded-sm" style="width:<%= (value / phases.total) * 100 %>%;background:<%= color %>;"></span>
                            </span>
                          </div>
                        <% } %>
                        <% if (phases.rest > 0) { %>
                          <div class="flex items-center gap-2 text-2xs">
                            <span class="inline-block h-2 w-2 shrink-0 rounded-sm bg-line"></span>
                            <span class="w-28 shrink-0 text-foreground-muted cursor-help" title="Time the phases do not account for: client-side work (interceptors, serialisation) and anything the client did not report — for fetch, a response body still streaming when the call was recorded.">Other</span>
                            <span class="w-16 shrink-0 text-right tabular-nums text-foreground-muted"><%= phaseMs(phases.rest) %></span>
                            <span class="min-w-0 grow">
                              <span class="block h-1.5 rounded-sm bg-line" style="width:<%= (phases.rest / phases.total) * 100 %>%;"></span>
                            </span>
                          </div>
                        <% } %>
                      </div>
                    </section>
                  <% } %>
                  <% if (hasRequest) { %>
                    <section class="bg-surface border border-line-subtle rounded p-2.5">
                      <p class="text-2xs text-foreground-faint uppercase tracking-widest font-semibold mb-1.5">Request</p>
                      <% if (r.requestHeaders && Object.keys(r.requestHeaders).length > 0) { %>
                        <div class="mb-2">
                          <p class="text-2xs text-foreground-muted font-semibold mb-1">Headers</p>
                          <div class="space-y-0.5">
                            <% for (const [k, v] of Object.entries(r.requestHeaders)) { %>
                              <div class="flex gap-2 text-2xs font-mono leading-relaxed">
                                <span class="text-foreground-secondary shrink-0"><%= k %>:</span>
                                <span class="text-foreground break-all"><%= v %></span>
                              </div>
                            <% } %>
                          </div>
                        </div>
                      <% } %>
                      <% if (r.requestBody != null) { %>
                        <div>
                          <p class="text-2xs text-foreground-muted font-semibold mb-1">Body</p>
                          <pre class="bg-surface-muted border border-line rounded p-2 overflow-x-auto text-2xs leading-relaxed"><code class="language-json"><%= toJson(r.requestBody) %></code></pre>
                        </div>
                      <% } %>
                    </section>
                  <% } %>

                  <% if (hasResponse) { %>
                    <section class="bg-surface border border-line-subtle rounded p-2.5">
                      <p class="text-2xs text-foreground-faint uppercase tracking-widest font-semibold mb-1.5">Response</p>
                      <% if (r.responseHeaders && Object.keys(r.responseHeaders).length > 0) { %>
                        <div class="mb-2">
                          <p class="text-2xs text-foreground-muted font-semibold mb-1">Headers</p>
                          <div class="space-y-0.5">
                            <% for (const [k, v] of Object.entries(r.responseHeaders)) { %>
                              <div class="flex gap-2 text-2xs font-mono leading-relaxed">
                                <span class="text-foreground-secondary shrink-0"><%= k %>:</span>
                                <span class="text-foreground break-all"><%= v %></span>
                              </div>
                            <% } %>
                          </div>
                        </div>
                      <% } %>
                      <% if (r.responseBody != null) { %>
                        <div>
                          <p class="text-2xs text-foreground-muted font-semibold mb-1">Body</p>
                          <pre class="bg-surface-muted border border-line rounded p-2 overflow-x-auto text-2xs leading-relaxed"><code class="language-json"><%= toJson(r.responseBody) %></code></pre>
                        </div>
                      <% } %>
                    </section>
                  <% } %>
                </div>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
